# Copy to .env (never commit .env). All variables are optional.
# Where the catalog database, features, indexes and settings live (default: data/store)
# MELODYAI_STORE_DIR=/path/to/store
# Alternative database (default: SQLite inside the store). PostgreSQL needs `pip install psycopg[binary]`.
# MELODYAI_DATABASE_URL=postgresql+psycopg://melodyai:melodyai@localhost:5432/melodyai
# Force a PyTorch device: auto | cpu | mps | cuda
# MELODYAI_DEVICE=auto
# Upload / duration limits
# MELODYAI_MAX_UPLOAD_MB=20
# MELODYAI_MAX_QUERY_SECONDS=60
# Allow the web UI to download Whisper models from the Hugging Face Hub (default: disabled)
# MELODYAI_ALLOW_MODEL_DOWNLOAD=false
# Load models/melody_encoder.pt at startup if present
# MELODYAI_LOAD_NEURAL_MODEL=true
# Comma-separated CORS origins for the API
# MELODYAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
